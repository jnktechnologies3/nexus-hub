# Ports (avoid 4173/5173/5174/8888 — used by other local apps)
WEB_PORT=3100
API_PORT=8100
# URL the browser uses to reach the API (baked into the web build)
NEXT_PUBLIC_API_URL=http://localhost:8100
# Optional API key. Empty = auth off. If set, send header X-API-Key.
# Note: the web UI embeds this key in its bundle, so it guards the API from other clients, not from people who can open the UI.
NEXUS_API_KEY=
# Seed 8 example agents + sample tasks/approvals on first start
NEXUS_SEED=true
# Comma-separated CORS origins
NEXUS_CORS=*
